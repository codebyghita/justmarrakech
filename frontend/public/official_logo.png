                                <input type="checkbox" name="agree_field" value="1" id="agree-term" class="new-control-input mshop-validation" data-validation="required">
                                <span class="new-control-indicator"></span><span>I have read and accept the <a href="https://justmarrakech.com/page/conditions-generales-de-vente">Terms and Conditions</a></span>
                            </label>
