                        <i class="fal fa-lock"></i>
                        <input id="rpassword" name="password" type="password" class="form-control mshop-validation" data-validation="required" placeholder="PASSWORD">
                        <div class="view-password">
                            <i class="fal fa-eye view"></i>
                            <i class="fal fa-eye-slash not-view"></i>
