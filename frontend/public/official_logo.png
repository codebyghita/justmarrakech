<script type="text/javascript">
   /*$('body').on('click', '.sv_support, .footer-close', function() {
         $('.sv_footer_popup').show();
      });*/

      $(document).ready(function(){

           $("#show").hide();

          $("#hide").click(function(){
                $("#show").show();
                $("#hide").hide();
             $(".sv_footer_popup").show();
             $('.uparrow').hide();
           $('.downarrow').show();

          });
          $("#show").click(function(){
                
                 $("#hide").show();
                 $("#show").hide();
              $(".sv_footer_popup").hide();
              $('.downarrow').hide();
             $('.uparrow').show();
        
          });

           $('.footer-close').click(function() {


            $('.sv_footer_popup').hide();
                  $("#hide").show();
                 $("#show").hide();
                 $('.uparrow').show();
          
           });



        /*$('.downarrow').hide();
         $('.sv_support').click(function() {
            $('.sv_footer_popup').show();
           $('.uparrow').hide();
           $('.downarrow').show();

           });

            $('.footer-close').click(function() {
            $('.sv_footer_popup').hide();
            $('.sv_support i').hide();
            $('.downarrow').hide();
             $('.uparrow').show();
           });*/



});
</script>

